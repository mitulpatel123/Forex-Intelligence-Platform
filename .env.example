FIP_ENV=development
FIP_BIND_HOST=127.0.0.1
FIP_HEALTH_PORT=8001
FIP_INGEST_PORT=8765
FIP_REDIS_URL=redis://127.0.0.1:6380/0
FIP_DATABASE_URL=postgresql://forex:forex_local_only@127.0.0.1:55432/forex
FIP_BRIDGE_TOKEN_FILE=.local/bridge-token
FIP_PARTIAL_STATE_MAX_AGE_SECONDS=2
FIP_STALE_AFTER_SECONDS=5
FIP_BRIDGE_STALE_AFTER_SECONDS=6
FIP_BRIDGE_SESSION_EXPIRY_SECONDS=60
FIP_DEDUP_CACHE_MAX_ENTRIES=100000
FIP_DEDUP_CACHE_TTL_SECONDS=3600
FIP_MAX_BROWSER_TO_COLLECTOR_DELAY_MS=30000
FIP_REJECT_NEGATIVE_BROWSER_TO_COLLECTOR_DELAY=false
FIP_REJECT_EXCESSIVE_BROWSER_TO_COLLECTOR_DELAY=false
FIP_REJECT_LOCAL_WALL_CLOCK_ADJUSTMENT=false
FIP_MISSING_OBSERVATION_SEQUENCE_SEVERITY=ERROR
FIP_NON_INCREASING_OBSERVATION_SEQUENCE_SEVERITY=ERROR
FIP_MAX_FUTURE_SKEW_SECONDS=2
FIP_RAW_PACKET_STORAGE=true
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=local-dev-change-me
