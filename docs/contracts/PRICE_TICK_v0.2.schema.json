{
  "$defs": {
    "AssetClass": {
      "enum": [
        "FX"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "GOOD",
        "WARNING",
        "BAD",
        "DUPLICATE",
        "LATE",
        "OUT_OF_ORDER",
        "STALE",
        "UNPARSEABLE"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "SupportedInstrument": {
      "enum": [
        "EURUSD",
        "GBPUSD",
        "USDJPY",
        "AUDUSD"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Milestone 2 registry-backed four-pair display quote.",
  "properties": {
    "adapter_instance_id": {
      "title": "Adapter Instance Id",
      "type": "string"
    },
    "ask": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Ask"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass",
      "default": "FX"
    },
    "base_currency": {
      "title": "Base Currency",
      "type": "string"
    },
    "bid": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Bid"
    },
    "browser_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Browser Observed At"
    },
    "browser_to_collector_delay_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Browser To Collector Delay Ms"
    },
    "changed_fields": {
      "items": {
        "enum": [
          "bid",
          "ask"
        ],
        "type": "string"
      },
      "title": "Changed Fields",
      "type": "array"
    },
    "collector_processing_delay_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Processing Delay Ms"
    },
    "collector_received_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Received At"
    },
    "document_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Session Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "PRICE_TICK",
      "default": "PRICE_TICK",
      "title": "Event Type",
      "type": "string"
    },
    "instrument": {
      "$ref": "#/$defs/SupportedInstrument"
    },
    "is_provider_tick": {
      "default": true,
      "title": "Is Provider Tick",
      "type": "boolean"
    },
    "is_snapshot": {
      "title": "Is Snapshot",
      "type": "boolean"
    },
    "mid": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Mid"
    },
    "normalized_at": {
      "format": "date-time",
      "title": "Normalized At",
      "type": "string"
    },
    "observation_level": {
      "default": "PROVIDER_TICK",
      "enum": [
        "DISPLAY_QUOTE",
        "PROVIDER_TICK"
      ],
      "title": "Observation Level",
      "type": "string"
    },
    "observation_sequence": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Sequence"
    },
    "pip_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Pip Size"
    },
    "provider": {
      "const": "IC_MARKETS",
      "default": "IC_MARKETS",
      "title": "Provider",
      "type": "string"
    },
    "provider_event_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Event Time"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "quote_currency": {
      "title": "Quote Currency",
      "type": "string"
    },
    "raw_event_id": {
      "title": "Raw Event Id",
      "type": "string"
    },
    "raw_payload_hash": {
      "title": "Raw Payload Hash",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence"
    },
    "source": {
      "default": "WEB_TERMINAL",
      "title": "Source",
      "type": "string"
    },
    "spread": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Spread"
    },
    "spread_pips": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Spread Pips"
    },
    "total_local_pipeline_delay_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Local Pipeline Delay Ms"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "adapter_instance_id",
    "instrument",
    "provider_event_time",
    "received_at",
    "normalized_at",
    "raw_event_id",
    "raw_payload_hash",
    "quality_status",
    "trace_id",
    "base_currency",
    "quote_currency",
    "bid",
    "ask",
    "mid",
    "spread",
    "spread_pips",
    "pip_size",
    "is_snapshot",
    "changed_fields"
  ],
  "title": "PriceTickV02",
  "type": "object"
}
